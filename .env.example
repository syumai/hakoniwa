# このファイルを .env にコピーして値を設定してください。
# mise 経由 (`mise exec -- ...` や `mise activate` 済みのシェル) であれば、
# リポジトリ直下の .env は mise.toml の [env] 設定により自動的に読み込まれます。

# 管理画面 (/admin) のパスワード。また、各島のオーナーパスワードとしても
# (島ごとのパスワードの代わりに) 常に通用する全島共通パスワードとして使えます。
HAKONIWA_MASTER_PASSWORD=change-me

# true にすると、トップページに「ターンを進める」ボタンが表示されます (開発用)。
# HAKONIWA_DEBUG=true

# true にすると、掲示板 (LBBS) 機能が有効になります。
# HAKONIWA_USE_LBBS=true
